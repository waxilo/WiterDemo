{
  "name": "writer-demo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply writer-demo --local",
    "db:migrate:remote": "wrangler d1 migrations apply writer-demo --remote"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "wrangler": "^4.113.0"
  }
}
